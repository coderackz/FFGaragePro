{
  "name": "fleetfix-garage-pro",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/sync && tsc -p apps/cloud && tsc -p apps/desktop",
    "dev": "npm run dev -w @ffgp/desktop",
    "e2e": "playwright test",
    "e2e:settings": "playwright test -c playwright.settings.config.ts",
    "e2e:credit": "playwright test -c playwright.credit.config.ts",
    "e2e:messages": "playwright test -c playwright.messages.config.ts",
    "e2e:books": "playwright test -c playwright.books.config.ts",
    "e2e:payables": "playwright test -c playwright.payables.config.ts",
    "e2e:electron": "playwright test -c playwright.electron.config.ts",
    "cloud": "npm run web:cloud -w @ffgp/desktop && npm run dev -w @ffgp/cloud",
    "e2e:cloud": "playwright test -c playwright.cloud.config.ts",
    "e2e:sync": "npm run build -w @ffgp/desktop && playwright test -c playwright.sync.config.ts",
    "e2e:vat": "playwright test -c playwright.vat.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
